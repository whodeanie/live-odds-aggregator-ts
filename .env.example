# Free tier from https://the-odds-api.com (500 requests / month).
ODDS_API_KEY=

# Region: us | uk | eu | au.
ODDS_API_REGION=us

# Sport key. Examples: americanfootball_nfl, basketball_nba, baseball_mlb.
ODDS_API_SPORT=americanfootball_nfl

# How long the server caches a fetch (seconds). Set to 60 by default to be a
# polite client and to keep the free tier alive across restarts.
CACHE_TTL_SECONDS=60

# Where the Next.js frontend points for API requests.
# Override per environment (Render service URL or local).
NEXT_PUBLIC_API_BASE=http://localhost:8787
